[
  {
    "id": "doc_example",
    "description": "The new_event_time() documentation example.",
    "input": {
      "time": {
        "r_type": "list",
        "values": [
          {
            "r_type": "double",
            "values": [7]
          },
          {
            "r_type": "double",
            "values": [2, 4]
          }
        ]
      },
      "status": {
        "r_type": "character",
        "values": [
          "e",
          "i"
        ]
      }
    },
    "result": {
      "ok": true,
      "length": 2,
      "fields": {
        "time": [
          [7],
          [2, 4]
        ],
        "status": [
          "e",
          "i"
        ]
      },
      "is_na": {
        "ok": true,
        "value": [false, false],
        "warnings": []
      },
      "format": {
        "ok": true,
        "value": [
          "7 ",
          "[2, 4]"
        ],
        "warnings": []
      },
      "print": {
        "ok": true,
        "value": ["<event_time[2]>", "[1] 7      [2, 4]"],
        "warnings": []
      },
      "extract_time": {
        "ok": true,
        "value": {
          "shape": "matrix",
          "columns": {
            "time": [7, 2],
            "time_max": ["NA", 4]
          }
        },
        "warnings": []
      },
      "extract_status": {
        "ok": true,
        "value": [
          "e",
          "i"
        ],
        "warnings": []
      },
      "as_surv": {
        "ok": true,
        "value": {
          "type": "interval",
          "columns": {
            "time1": [7, 2],
            "time2": [1, 4],
            "status": [1, 3]
          }
        },
        "warnings": []
      },
      "as_tibble": {
        "ok": true,
        "value": {
          "time": [7, 2],
          "status": [
            "e",
            "i"
          ],
          "time_max": ["NA", 4]
        },
        "warnings": []
      }
    }
  },
